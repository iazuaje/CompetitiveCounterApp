<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Tema cálido pastel (acento más saturado para botones activos) -->
    <Color x:Key="Primary">#C45C3E</Color>
    <Color x:Key="PrimaryDark">#E8957A</Color>
    <Color x:Key="PrimaryDarkText">#2F221C</Color>
    <Color x:Key="Secondary">#F0C9B4</Color>
    <Color x:Key="SecondaryDarkText">#D4846A</Color>
    <Color x:Key="Tertiary">#8F4A36</Color>

    <Color x:Key="EditingColorDark">#3A2A24</Color>
    <Color x:Key="EditingColorLight">#E0A88C</Color>

    <Color x:Key="DarkBackground">#2A221E</Color>
    <Color x:Key="LightOnDarkBackground">#E8DDD4</Color>
    <Color x:Key="LightBackground">#FFF8F3</Color>
    <Color x:Key="DarkOnLightBackground">#3D3229</Color>

    <Color x:Key="LightSecondaryBackground">#F0E4D8</Color>
    <Color x:Key="DarkSecondaryBackground">#3A322C</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#B85A66</Color>
    <Color x:Key="MidnightBlue">#4A3728</Color>
    <Color x:Key="OffBlack">#2A221E</Color>

    <Color x:Key="Gray100">#F0E8E0</Color>
    <Color x:Key="Gray200">#D9CEC4</Color>
    <Color x:Key="Gray300">#BFAFA3</Color>
    <Color x:Key="Gray400">#A39488</Color>
    <Color x:Key="Gray500">#85766A</Color>
    <Color x:Key="Gray600">#5C4F45</Color>
    <Color x:Key="Gray900">#3D3229</Color>
    <Color x:Key="Gray950">#2A221E</Color>

    <!-- Colores para juegos - Versión Light -->
    <Color x:Key="GameColorRed">#E63946</Color>
    <Color x:Key="GameColorBlue">#457B9D</Color>
    <Color x:Key="GameColorGreen">#2A9D8F</Color>
    <Color x:Key="GameColorOrange">#F77F00</Color>
    <Color x:Key="GameColorPurple">#9B59B6</Color>
    <Color x:Key="GameColorPink">#E91E63</Color>
    <Color x:Key="GameColorTeal">#00BCD4</Color>
    <Color x:Key="GameColorAmber">#FFC107</Color>
    <Color x:Key="GameColorIndigo">#3F51B5</Color>
    <Color x:Key="GameColorLime">#8BC34A</Color>

    <!-- Colores para juegos - Versión Dark -->
    <Color x:Key="GameColorRedDark">#FF5964</Color>
    <Color x:Key="GameColorBlueDark">#6DA5D0</Color>
    <Color x:Key="GameColorGreenDark">#4ECDC4</Color>
    <Color x:Key="GameColorOrangeDark">#FFB04C</Color>
    <Color x:Key="GameColorPurpleDark">#B57EDC</Color>
    <Color x:Key="GameColorPinkDark">#FF4081</Color>
    <Color x:Key="GameColorTealDark">#4DD0E1</Color>
    <Color x:Key="GameColorAmberDark">#FFD54F</Color>
    <Color x:Key="GameColorIndigoDark">#7986CB</Color>
    <Color x:Key="GameColorLimeDark">#AED581</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
