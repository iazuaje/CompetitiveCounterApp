<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             xmlns:pageModels="clr-namespace:CompetitiveCounterApp.PageModels"
             xmlns:models="clr-namespace:CompetitiveCounterApp.Models;assembly=CompetitiveCounterApp.Data"
             xmlns:behaviors="clr-namespace:CompetitiveCounterApp.Behaviors"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CompetitiveCounterApp.Pages.SessionDetailPage"
             x:DataType="pageModels:SessionDetailPageModel"
             x:Name="SessionDetailRoot"
             Title="{Binding Title}"
             Shell.BackgroundColor="{Binding Game.CurrentGameColor}"
             Shell.ForegroundColor="{StaticResource White}"
             Shell.TitleColor="{StaticResource White}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference SessionDetailRoot}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <Style x:Key="WinsAdjustButton" TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="WidthRequest" Value="36" />
                <Setter Property="HeightRequest" Value="36" />
                <Setter Property="MinimumWidthRequest" Value="36" />
                <Setter Property="MinimumHeightRequest" Value="36" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1" />
                                    <Setter Property="Opacity" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.96" />
                                    <Setter Property="Opacity" Value="0.92" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.4" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cerrar sesión"
                     Command="{Binding CloseSessionCommand}"
                     IconImageSource="{StaticResource IconCloseSessionShell}"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
    </ContentPage.ToolbarItems>

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
        <Grid RowDefinitions="Auto,*"
              Padding="15"
              RowSpacing="12">
            <VerticalStackLayout Spacing="6">
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding SessionDateText}"
                               FontSize="16"
                               FontAttributes="Bold" />
                        <Label Text="{Binding Notes}"
                               IsVisible="{Binding HasNotes}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="Clasificación"
                       FontSize="18"
                       FontAttributes="Bold"
                       Margin="0,10,0,0" />
                <BoxView HeightRequest="2"
                         BackgroundColor="{Binding Game.CurrentGameColor}"
                         HorizontalOptions="Fill" />
            </VerticalStackLayout>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="10">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Leaderboard}"
                                         Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:SessionPlayer">
                                <Border StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                        Padding="12,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                          ColumnSpacing="10"
                                          VerticalOptions="Center">
                                        <Border WidthRequest="40"
                                                HeightRequest="40"
                                                StrokeThickness="0"
                                                Background="{Binding Player.CurrentColor}"
                                                VerticalOptions="Center"
                                                StrokeShape="Ellipse"
                                                Padding="0">
                                            <Image HeightRequest="20"
                                                   WidthRequest="20"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center">
                                                <Image.Source>
                                                    <FontImageSource Glyph="{Binding Player.Icon}"
                                                                     FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                                     Color="White"
                                                                     Size="20" />
                                                </Image.Source>
                                            </Image>
                                        </Border>

                                        <Label Grid.Column="1"
                                               Text="{Binding Player.Name}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               LineBreakMode="TailTruncation" />

                                        <HorizontalStackLayout Grid.Column="2"
                                                               Spacing="4"
                                                               VerticalOptions="Center"
                                                               SemanticProperties.Description="Tocar para editar victorias"
                                                               behaviors:AnimatedTap.Command="{Binding EditWinsCommand, Source={RelativeSource AncestorType={x:Type pageModels:SessionDetailPageModel}}, x:DataType=pageModels:SessionDetailPageModel}"
                                                               behaviors:AnimatedTap.CommandParameter="{Binding .}"
                                                               behaviors:AnimatedTap.PressedScale="0.97"
                                                               behaviors:AnimatedTap.PressedOpacity="0.92">
                                            <Image HeightRequest="18"
                                                   WidthRequest="18"
                                                   InputTransparent="True"
                                                   VerticalOptions="Center">
                                                <Image.Source>
                                                    <FontImageSource Glyph="{x:Static f:FluentUI.crown_24_regular}"
                                                                     FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                                     Color="{Binding Game.CurrentGameColor, Source={RelativeSource AncestorType={x:Type pageModels:SessionDetailPageModel}}, x:DataType=pageModels:SessionDetailPageModel}"
                                                                     Size="18" />
                                                </Image.Source>
                                            </Image>
                                            <Label Text="{Binding Wins}"
                                                   InputTransparent="True"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"
                                                   TextColor="{Binding Game.CurrentGameColor, Source={RelativeSource AncestorType={x:Type pageModels:SessionDetailPageModel}}, x:DataType=pageModels:SessionDetailPageModel}" />
                                        </HorizontalStackLayout>

                                        <VerticalStackLayout Grid.Column="3"
                                                             Spacing="6"
                                                             VerticalOptions="Center"
                                                             IsVisible="{Binding IsActive, Source={RelativeSource AncestorType={x:Type pageModels:SessionDetailPageModel}}, x:DataType=pageModels:SessionDetailPageModel}">
                                            <Button Text="+"
                                                    Style="{StaticResource WinsAdjustButton}"
                                                    BackgroundColor="{Binding Game.CurrentGameColor, Source={RelativeSource AncestorType={x:Type pageModels:SessionDetailPageModel}}, x:DataType=pageModels:SessionDetailPageModel}"
                                                    TextColor="White"
                                                    Command="{Binding IncrementWinsCommand, Source={RelativeSource AncestorType={x:Type pageModels:SessionDetailPageModel}}, x:DataType=pageModels:SessionDetailPageModel}"
                                                    CommandParameter="{Binding .}"
                                                    SemanticProperties.Description="Sumar victoria" />
                                            <Button Text="−"
                                                    Style="{StaticResource WinsAdjustButton}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                                                    Command="{Binding DecrementWinsCommand, Source={RelativeSource AncestorType={x:Type pageModels:SessionDetailPageModel}}, x:DataType=pageModels:SessionDetailPageModel}"
                                                    CommandParameter="{Binding .}"
                                                    SemanticProperties.Description="Restar victoria" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="Agregá jugadores para armar la clasificación"
                           IsVisible="{Binding HasPlayers, Converter={StaticResource InvertedBoolConverter}}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                           HorizontalOptions="Center"
                           Margin="0,30" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <Border HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Padding="18,12"
                StrokeThickness="0"
                Background="{Binding Game.CurrentGameColor}"
                IsVisible="{Binding IsActive}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                SemanticProperties.Description="Agregar jugador"
                behaviors:AnimatedTap.Command="{Binding AddPlayerCommand}"
                behaviors:AnimatedTap.PressedScale="0.97"
                behaviors:AnimatedTap.PressedOpacity="0.92">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28" />
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center" InputTransparent="True">
                <Label Text="Agregar"
                       TextColor="White"
                       FontSize="16"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
                <Image HeightRequest="22"
                       WidthRequest="22"
                       VerticalOptions="Center">
                    <Image.Source>
                        <FontImageSource Glyph="{x:Static f:FluentUI.person_add_24_regular}"
                                         FontFamily="{x:Static f:FluentUI.FontFamily}"
                                         Color="White"
                                         Size="22" />
                    </Image.Source>
                </Image>
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>
