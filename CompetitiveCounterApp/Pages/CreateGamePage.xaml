<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
             xmlns:pageModels="clr-namespace:CompetitiveCounterApp.PageModels"
             xmlns:controls="clr-namespace:CompetitiveCounterApp.Pages.Controls"
             xmlns:models="clr-namespace:CompetitiveCounterApp.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CompetitiveCounterApp.Pages.CreateGamePage"
             x:DataType="pageModels:CreateGamePageModel"
             Title="Crear Nuevo Juego">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Guardar"
                     Command="{Binding SaveCommand}"
                     IconImageSource="{StaticResource IconSave}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="0.4*, *" BackgroundColor="{Binding SelectedColor.CurrentGameColor}">
        <Image Source="{Binding SelectedImage}" Aspect="AspectFill" Margin="0,0,0,-30"></Image>
        <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center" Margin="10">
            <Border Background="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 50" Padding="40,10" Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource PrimaryDark}}">
                <Border.Shadow>
                    <Shadow Offset="0,4" Radius="8" Opacity="0.5"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="5">
                    <Label Text="Nombre del Juego" HorizontalTextAlignment="Center"
                            FontSize="16"
                            FontAttributes="Bold">
                    </Label>
                    <BoxView HeightRequest="1" Color="Gray"></BoxView>
                    <HorizontalStackLayout>
                        <Image>
                            <Image.Source>
                                <FontImageSource Glyph="{Binding SelectedIcon.Icon}" 
                            FontFamily="{Static f:FluentUI.FontFamily}" 
                            Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                            Size="40">
                                </FontImageSource>
                            </Image.Source>
                        </Image>
                        <Entry Text="{Binding Name}"
                        MinimumWidthRequest="200"
                        TextColor="{Binding SelectedColor.CurrentGameColor}"
                        ClearButtonVisibility="WhileEditing"
                        Placeholder=""
                        HorizontalTextAlignment="Center"
                        FontSize="18">
                            <Entry.Keyboard>
                                <Keyboard x:FactoryMethod="Create">
                                    <x:Arguments>
                                        <KeyboardFlags>Suggestions,CapitalizeSentence</KeyboardFlags>
                                    </x:Arguments>
                                </Keyboard>
                            </Entry.Keyboard>
                        </Entry>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" IsVisible="{Binding SelectedImage, Converter={toolkit:IsNullConverter}}">
                <Image Source="{StaticResource IconWarning}" />
                <Label 
                    Text="No se ha cargado una imagen" VerticalOptions="Center" TextColor="White" HorizontalOptions="Center" FontSize="12"></Label>
                <Image Source="{StaticResource IconWarning}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <Border Grid.Row="1" Background="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}" Padding="10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30,30,0,0"></RoundRectangle>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Offset="0,-10" Radius="10" Opacity="0.2"/>
            </Border.Shadow>
            <ScrollView>
                <VerticalStackLayout Spacing="10">
                    <Grid>
                        <sf:SfSegmentedControl SelectedIndex="0" ShowSeparator="False" SegmentCornerRadius="10" AutoScrollToSelectedSegment="True" 
                                        BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}}"
                                        SelectionChanged="SfSegmentedControl_SelectionChanged"
                                        >
                            <sf:SfSegmentedControl.SelectionIndicatorSettings>
                                <sf:SelectionIndicatorSettings SelectionIndicatorPlacement="Fill" 
                                                        Background="{Binding SelectedColor.CurrentGameColor, 
                                                        Source={RelativeSource AncestorType={x:Type pageModels:CreateGamePageModel}}, x:DataType=pageModels:CreateGamePageModel}"
                                                        StrokeThickness="10"
                                                        Stroke="Black"
                                                        >
                                </sf:SelectionIndicatorSettings>

                            </sf:SfSegmentedControl.SelectionIndicatorSettings>

                            <sf:SfSegmentedControl.ItemsSource>
                                <x:Array Type="{x:Type sf:SfSegmentItem}">
                                    <sf:SfSegmentItem ImageSource="{StaticResource IconAddImage}" Text="Imagen"/>
                                    <sf:SfSegmentItem ImageSource="{StaticResource IconAddIcon}" Text="Icono"/>
                                </x:Array>
                            </sf:SfSegmentedControl.ItemsSource>
                        </sf:SfSegmentedControl>
                    </Grid>
                    <Grid x:Name="selectorImagen" >
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Descripción" FontAttributes="Bold"/>
                            <Border Padding="0" HeightRequest="100">
                                <Grid>
                                    <Image IsVisible="{Binding SelectedImage, Converter={toolkit:IsNullConverter}}" Source="{StaticResource IconNoImage}" HeightRequest="30" Margin="10" VerticalOptions="End" HorizontalOptions="End"></Image>
                                    <Image Aspect="AspectFill" IsVisible="{Binding SelectedImage, Converter={toolkit:IsNotNullConverter}}" Source="{Binding SelectedImage}" ></Image>
                                    <Button Text="Cargar Imagen" VerticalOptions="Center" Margin="10"
                                Command="{Binding SelectImageCommand}"
                                HorizontalOptions="Start" ImageSource="{StaticResource IconAddImage}">
                                        <Button.Shadow>
                                            <Shadow Offset="0,4" Opacity="0.5" Radius="10"/>
                                        </Button.Shadow>
                                    </Button>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    <controls:IconPicker x:Name="selectorIcon"
                                    ItemsSource="{Binding Icons}" 
                                    SelectedItem="{Binding SelectedIcon}"
                                    SelectedColor="{Binding SelectedColor}"
                                    ItemCommand="{Binding SelectIconCommand}"></controls:IconPicker>
                    <controls:ColorPicker x:Name="selectorColor" ItemsSource="{Binding GameColors}" SelectedItem="{Binding SelectedColor}" ItemCommand="{Binding SelectColorCommand}"/>
                    <Border>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Descripcion (Opcional)"
                            FontSize="16"
                            FontAttributes="Bold" />
                            <Editor Text="{Binding Description}"
                    Placeholder="Agrega una descripcion del juego..."
                    HeightRequest="100"
                    FontSize="14" />
                        </VerticalStackLayout>
                    </Border>
                    <Button Text="Crear Juego"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    HeightRequest="56"
                    CornerRadius="12"
                    Margin="0,20,0,0"
                    HorizontalOptions="Fill"
                    ImageSource="{StaticResource IconSave}" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>

