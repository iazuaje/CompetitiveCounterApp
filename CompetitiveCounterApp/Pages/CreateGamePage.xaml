                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger
                                        TargetType="Border"
                                        Binding="{Binding IsSelected}"
                                        Value="True">
                                            <Setter Property="Stroke"
                                            Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
