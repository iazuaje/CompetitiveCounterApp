                                        <TapGestureRecognizer Command="{Binding SelectIconCommand, Source={RelativeSource AncestorType={x:Type pageModels:CreateGamePageModel}}, x:DataType=pageModels:CreateGamePageModel}"
                                                          CommandParameter="{Binding .}" />

                                    </Border.GestureRecognizers>

                                    <Image>
                                        <Image.Source>
                                            <FontImageSource Glyph="{Binding Icon}" FontFamily="{Static f:FluentUI.FontFamily}" 
                                                         Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}">
