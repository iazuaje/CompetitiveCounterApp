<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             xmlns:pageModels="clr-namespace:CompetitiveCounterApp.PageModels"
             xmlns:models="clr-namespace:CompetitiveCounterApp.Models;assembly=CompetitiveCounterApp.Data"
             xmlns:behaviors="clr-namespace:CompetitiveCounterApp.Behaviors"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CompetitiveCounterApp.Pages.GameDetailPage"
             x:DataType="pageModels:GameDetailPageModel"
             x:Name="GameDetailRoot"
             Title="{Binding Name}"
             Shell.BackgroundColor="{Binding Game.ToolbarColor}"
             Shell.ForegroundColor="{StaticResource White}"
             Shell.TitleColor="{StaticResource White}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference GameDetailRoot}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Editar"
                     Command="{Binding EditCommand}"
                     IconImageSource="{StaticResource IconEditShell}" />
        <ToolbarItem Text="Eliminar"
                     Command="{Binding DeleteCommand}"
                     IconImageSource="{StaticResource IconDeleteShell}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="0.4*, *" BackgroundColor="{Binding Game.CurrentGameColor}">
        <Image Source="{Binding Game.GameImage}" Aspect="AspectFill" Margin="0,0,0,-30" />
        <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center" Margin="10">
            <Border Background="{Binding Game.SurfaceColor}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 50"
                    Padding="40,10"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource White}}">
                <Border.Shadow>
                    <Shadow Offset="0,4" Radius="8" Opacity="0.5"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding Name}"
                           HorizontalTextAlignment="Center"
                           FontSize="20"
                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}"
                           FontAttributes="Bold" />
                    <BoxView HeightRequest="1" Color="Gray" />
                    <Image>
                        <Image.Source>
                            <FontImageSource Glyph="{Binding SelectedIcon.Icon}"
                                             FontFamily="{Static f:FluentUI.FontFamily}"
                                             Color="{Binding Game.OnSurfaceColor}"
                                             Size="40" />
                        </Image.Source>
                    </Image>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
        <Border Grid.Row="1"
                Background="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
                Padding="10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30,30,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Offset="0,-10" Radius="10" Opacity="0.2"/>
            </Border.Shadow>
            <ScrollView>
                <VerticalStackLayout Spacing="15" Padding="0,0,0,10">
                    <Border IsVisible="{Binding HasDescription}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Descripción"
                                   FontSize="16"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding Description}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>
                    </Border>

                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="Sesiones de Juego"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Button Text="+"
                                Command="{Binding AddSessionCommand}"
                                BackgroundColor="{Binding Game.CurrentGameColor}"
                                TextColor="White"
                                FontSize="20"
                                FontAttributes="Bold"
                                Padding="0"
                                BorderWidth="0"
                                CornerRadius="16"
                                WidthRequest="32"
                                HeightRequest="32"
                                MinimumWidthRequest="32"
                                MinimumHeightRequest="32"
                                VerticalOptions="Center"
                                SemanticProperties.Description="Nueva sesión" />
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="2"
                             BackgroundColor="{Binding Game.CurrentGameColor}"
                             HorizontalOptions="Fill" />

                    <Label Text="No hay sesiones registradas aún"
                           IsVisible="{Binding HasSessions, Converter={StaticResource InvertedBoolConverter}}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0" />

                    <FlexLayout Wrap="Wrap"
                                Direction="Row"
                                AlignItems="Stretch"
                                JustifyContent="Start"
                                BindableLayout.ItemsSource="{Binding Sessions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Session">
                                <Border Padding="10,8"
                                        Margin="0,0,8,10"
                                        FlexLayout.Basis="31%"
                                        Background="{Binding ListCardBackground}"
                                        Stroke="{Binding ListCardStroke}"
                                        StrokeThickness="{Binding ListCardStrokeThickness}"
                                        behaviors:AnimatedTap.Command="{Binding NavigateToSessionCommand, Source={RelativeSource AncestorType={x:Type pageModels:GameDetailPageModel}}, x:DataType=pageModels:GameDetailPageModel}"
                                        behaviors:AnimatedTap.CommandParameter="{Binding .}"
                                        behaviors:AnimatedTap.PressedScale="0.97"
                                        behaviors:AnimatedTap.PressedOpacity="0.92">
                                    <VerticalStackLayout Spacing="6" InputTransparent="True">
                                        <Label FontSize="14"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2"
                                               Text="{Binding SessionDateLocal, StringFormat='{}{0:dd/MM/yy HH:mm}'}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                            <Image HeightRequest="16" WidthRequest="16" VerticalOptions="Center">
                                                <Image.Source>
                                                    <FontImageSource Glyph="{x:Static f:FluentUI.star_24_regular}"
                                                                     FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                                     Color="{Binding ListCardIconColor}"
                                                                     Size="16" />
                                                </Image.Source>
                                            </Image>
                                            <Label Text="{Binding TotalWins}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"
                                                   TextColor="{Binding Game.CurrentGameColor, Source={RelativeSource AncestorType={x:Type pageModels:GameDetailPageModel}}, x:DataType=pageModels:GameDetailPageModel}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Image HeightRequest="16" WidthRequest="16" VerticalOptions="Center" Margin="6,0,0,0">
                                                <Image.Source>
                                                    <FontImageSource Glyph="{x:Static f:FluentUI.people_24_regular}"
                                                                     FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                                     Color="{Binding ListCardIconColor}"
                                                                     Size="16" />
                                                </Image.Source>
                                            </Image>
                                            <Label Text="{Binding PlayerCount}"
                                                   FontSize="15"
                                                   VerticalOptions="Center"
                                                   TextColor="{Binding ListCardIconColor}" />
                                        </HorizontalStackLayout>

                                        <Label Text="Activa"
                                               IsVisible="{Binding IsActive}"
                                               HorizontalOptions="End"
                                               TextColor="White"
                                               FontSize="12"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>

</ContentPage>
