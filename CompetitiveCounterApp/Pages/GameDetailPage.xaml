<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             xmlns:pageModels="clr-namespace:CompetitiveCounterApp.PageModels"
             xmlns:models="clr-namespace:CompetitiveCounterApp.Models;assembly=CompetitiveCounterApp.Data"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CompetitiveCounterApp.Pages.GameDetailPage"
             x:DataType="pageModels:GameDetailPageModel"
             x:Name="GameDetailRoot"
             Title="{Binding Name}"
             Shell.BackgroundColor="{Binding Game.ToolbarColor}"
             Shell.ForegroundColor="{StaticResource White}"
             Shell.TitleColor="{StaticResource White}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference GameDetailRoot}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Editar"
                     Command="{Binding EditCommand}"
                     IconImageSource="{StaticResource IconEditShell}" />
        <ToolbarItem Text="Eliminar"
                     Command="{Binding DeleteCommand}"
                     IconImageSource="{StaticResource IconDeleteShell}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="0.4*, *" BackgroundColor="{Binding Game.CurrentGameColor}">
        <Image Source="{Binding Game.GameImage}" Aspect="AspectFill" Margin="0,0,0,-30" />
        <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center" Margin="10">
            <Border Background="{Binding Game.SurfaceColor}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 50"
                    Padding="40,10"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource White}}">
                <Border.Shadow>
                    <Shadow Offset="0,4" Radius="8" Opacity="0.5"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding Name}"
                           HorizontalTextAlignment="Center"
                           FontSize="20"
                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}"
                           FontAttributes="Bold" />
                    <BoxView HeightRequest="1" Color="Gray" />
                    <Image>
                        <Image.Source>
                            <FontImageSource Glyph="{Binding SelectedIcon.Icon}"
                                             FontFamily="{Static f:FluentUI.FontFamily}"
                                             Color="{Binding Game.OnSurfaceColor}"
                                             Size="40" />
                        </Image.Source>
                    </Image>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
        <Border Grid.Row="1"
                Background="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
                Padding="10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30,30,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Offset="0,-10" Radius="10" Opacity="0.2"/>
            </Border.Shadow>
            <CollectionView ItemsSource="{Binding Sessions}"
                            SelectionMode="None">
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="15"
                                         Padding="0,0,0,10"
                                         BindingContext="{Binding BindingContext, Source={x:Reference GameDetailRoot}, x:DataType=ContentPage}">
                        <Border>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Descripción"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Description}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                            </VerticalStackLayout>
                        </Border>

                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="Sesiones de Juego"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <Border WidthRequest="32"
                                    HeightRequest="32"
                                    Padding="0"
                                    Background="{Binding Game.CurrentGameColor}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="Nueva sesión">
                                <Border.StrokeShape>
                                    <Ellipse />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AddSessionCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="+"
                                       TextColor="White"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="3"
                                     HorizontalItemSpacing="10"
                                     VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Session">
                        <Border Padding="12"
                                Background="{Binding ListCardBackground}"
                                Stroke="{Binding ListCardStroke}"
                                StrokeThickness="{Binding ListCardStrokeThickness}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding NavigateToSessionCommand, Source={RelativeSource AncestorType={x:Type pageModels:GameDetailPageModel}}, x:DataType=pageModels:GameDetailPageModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                                <Label FontSize="13"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"
                                       Text="{Binding SessionDateLocal, StringFormat='{}{0:dd/MM/yy HH:mm}'}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <HorizontalStackLayout Grid.Row="1" Spacing="6" VerticalOptions="Center">
                                    <Image HeightRequest="16" WidthRequest="16" VerticalOptions="Center">
                                        <Image.Source>
                                            <FontImageSource Glyph="{x:Static f:FluentUI.star_24_regular}"
                                                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                             Color="{Binding ListCardIconColor}"
                                                             Size="16" />
                                        </Image.Source>
                                    </Image>
                                    <Label Text="{Binding TotalWins}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           TextColor="{Binding Game.CurrentGameColor, Source={RelativeSource AncestorType={x:Type pageModels:GameDetailPageModel}}, x:DataType=pageModels:GameDetailPageModel}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Image HeightRequest="16" WidthRequest="16" VerticalOptions="Center" Margin="8,0,0,0">
                                        <Image.Source>
                                            <FontImageSource Glyph="{x:Static f:FluentUI.people_24_regular}"
                                                             FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                             Color="{Binding ListCardIconColor}"
                                                             Size="16" />
                                        </Image.Source>
                                    </Image>
                                    <Label Text="{Binding PlayerCount}"
                                           FontSize="14"
                                           VerticalOptions="Center"
                                           TextColor="{Binding ListCardIconColor}" />
                                </HorizontalStackLayout>

                                <Label Grid.Row="3"
                                       Text="Activa"
                                       IsVisible="{Binding IsActive}"
                                       HorizontalOptions="End"
                                       VerticalOptions="End"
                                       TextColor="White"
                                       FontSize="10"
                                       FontAttributes="Bold" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="No hay sesiones registradas aún"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                           HorizontalOptions="Center"
                           Margin="0,20" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Border>
    </Grid>

</ContentPage>
