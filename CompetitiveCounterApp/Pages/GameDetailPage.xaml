<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             xmlns:pageModels="clr-namespace:CompetitiveCounterApp.PageModels"
             xmlns:models="clr-namespace:CompetitiveCounterApp.Models;assembly=CompetitiveCounterApp.Data"
             xmlns:appModels="clr-namespace:CompetitiveCounterApp.Models"
             xmlns:behaviors="clr-namespace:CompetitiveCounterApp.Behaviors"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CompetitiveCounterApp.Pages.GameDetailPage"
             x:DataType="pageModels:GameDetailPageModel"
             x:Name="GameDetailRoot"
             Title="{Binding Name}"
             Shell.BackgroundColor="{Binding Game.ToolbarColor}"
             Shell.ForegroundColor="{Binding Game.OnToolbarColor}"
             Shell.TitleColor="{Binding Game.OnToolbarColor}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference GameDetailRoot}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Editar"
                     Command="{Binding EditCommand}"
                     IconImageSource="{StaticResource IconEditShell}" />
        <ToolbarItem Text="Eliminar"
                     Command="{Binding DeleteCommand}"
                     IconImageSource="{StaticResource IconDeleteShell}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="0.4*, *" BackgroundColor="{Binding Game.CurrentGameColor}">
        <Image Source="{Binding Game.GameImage}" Aspect="AspectFill" Margin="0,0,0,-30" />
        <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center" Margin="10">
            <Border Background="{Binding Game.SurfaceColor}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 50"
                    Padding="40,10"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource White}}">
                <Border.Shadow>
                    <Shadow Offset="0,4" Radius="8" Opacity="0.5"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding Name}"
                           HorizontalTextAlignment="Center"
                           FontSize="20"
                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}"
                           FontAttributes="Bold" />
                    <BoxView HeightRequest="1" Color="Gray" />
                    <Image>
                        <Image.Source>
                            <FontImageSource Glyph="{Binding SelectedIcon.Icon}"
                                             FontFamily="{Static f:FluentUI.FontFamily}"
                                             Color="{Binding Game.OnSurfaceColor}"
                                             Size="40" />
                        </Image.Source>
                    </Image>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
        <Border Grid.Row="1"
                Background="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
                Padding="10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30,30,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Offset="0,-10" Radius="10" Opacity="0.2"/>
            </Border.Shadow>
            <ScrollView>
                <VerticalStackLayout Spacing="5" Padding="0,0,0,10">
                    <Border IsVisible="{Binding HasDescription}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Descripción"
                                   FontSize="16"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding Description}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8"
                          VerticalOptions="Center"
                          Margin="0">
                        <Label Text="Clasificación"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Stats"
                                Command="{Binding OpenStatsCommand}"
                                BackgroundColor="{Binding Game.CurrentGameColor}"
                                TextColor="{Binding Game.OnGameColor}"
                                FontSize="13"
                                FontAttributes="Bold"
                                Padding="12,0"
                                BorderWidth="0"
                                CornerRadius="20"
                                VerticalOptions="Center"
                                SemanticProperties.Description="Estadísticas" />
                    </Grid>


                    <Label Text="Todavía no hay victorias registradas"
                           IsVisible="{Binding HasLeaderboard, Converter={StaticResource InvertedBoolConverter}}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                           HorizontalOptions="Center"
                           Margin="0,8,0,4" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Leaderboard}"
                                         Spacing="8"
                                         Margin="0,4,0,10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="appModels:GameLeaderboardEntry">
                                <!-- Fila neutra: el color de medalla vive solo en la insignia y en el borde del 1º. Tap: estadísticas del jugador. -->
                                <Border Padding="12,8"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                        SemanticProperties.Description="{Binding PlayerName, StringFormat='Ver estadísticas de {0}'}"
                                        behaviors:AnimatedTap.Command="{Binding NavigateToPlayerCommand, Source={RelativeSource AncestorType={x:Type pageModels:GameDetailPageModel}}, x:DataType=pageModels:GameDetailPageModel}"
                                        behaviors:AnimatedTap.CommandParameter="{Binding .}"
                                        behaviors:AnimatedTap.PressedScale="0.97"
                                        behaviors:AnimatedTap.PressedOpacity="0.92">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsFirst}" Value="True">
                                            <Setter Property="Stroke" Value="{Binding MedalColor}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="12"
                                          VerticalOptions="Center"
                                          InputTransparent="True">
                                        <!-- Avatar del jugador con la insignia de puesto en la esquina. -->
                                        <Grid WidthRequest="46"
                                              HeightRequest="46"
                                              VerticalOptions="Center">
                                            <Border WidthRequest="40"
                                                    HeightRequest="40"
                                                    StrokeThickness="0"
                                                    StrokeShape="Ellipse"
                                                    Padding="0"
                                                    Background="{Binding PlayerColor}"
                                                    HorizontalOptions="Start"
                                                    VerticalOptions="Start">
                                                <Image HeightRequest="20"
                                                       WidthRequest="20"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center">
                                                    <Image.Source>
                                                        <FontImageSource Glyph="{Binding PlayerIcon}"
                                                                         FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                                         Color="{Binding OnPlayerColor}"
                                                                         Size="20" />
                                                    </Image.Source>
                                                </Image>
                                            </Border>
                                            <Border WidthRequest="22"
                                                    HeightRequest="22"
                                                    StrokeThickness="2"
                                                    StrokeShape="Ellipse"
                                                    Padding="0"
                                                    Stroke="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                                    Background="{Binding MedalColor}"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="End"
                                                    SemanticProperties.Description="{Binding Rank, StringFormat='Puesto {0}'}">
                                                <Label Text="{Binding Rank}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding MedalTextColor}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                        </Grid>

                                        <Label Grid.Column="1"
                                               Text="{Binding PlayerName}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}"
                                               LineBreakMode="TailTruncation"
                                               VerticalOptions="Center" />

                                        <!-- Criterio del ranking: sesiones ganadas (trofeo); victorias como dato secundario. -->
                                        <VerticalStackLayout Grid.Column="2"
                                                             Spacing="0"
                                                             VerticalOptions="Center"
                                                             SemanticProperties.Description="{Binding SessionsWon, StringFormat='{0} sesiones ganadas'}">
                                            <HorizontalStackLayout Spacing="4" HorizontalOptions="End">
                                                <Label Text="{Binding SessionsWon}"
                                                       FontSize="18"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}"
                                                       VerticalOptions="Center" />
                                                <Image HeightRequest="20"
                                                       WidthRequest="20"
                                                       VerticalOptions="Center">
                                                    <Image.Source>
                                                        <FontImageSource Glyph="{x:Static f:FluentUI.trophy_24_regular}"
                                                                         FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                                         Color="{Binding MedalColor}"
                                                                         Size="20" />
                                                    </Image.Source>
                                                </Image>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding TotalWinsText}"
                                                   FontSize="11"
                                                   HorizontalOptions="End"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,auto" VerticalOptions="Center">
                        <Label Text="Sesiones de Juego"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Button Text="Nueva sesión +"
                                Grid.Column="1"
                                Command="{Binding AddSessionCommand}"
                                BackgroundColor="{Binding Game.CurrentGameColor}"
                                TextColor="{Binding Game.OnGameColor}"
                                FontSize="13"
                                FontAttributes="Bold"
                                Padding="12, 0"
                                BorderWidth="0"
                                CornerRadius="20"
                                VerticalOptions="Center"
                                SemanticProperties.Description="Nueva sesión" />
                    </Grid>

                    <Label Text="No hay sesiones registradas aún"
                           IsVisible="{Binding HasSessions, Converter={StaticResource InvertedBoolConverter}}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0" />

                    <FlexLayout Wrap="Wrap"
                                Direction="Row"
                                AlignItems="Stretch"
                                JustifyContent="Start"
                                BindableLayout.ItemsSource="{Binding Sessions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Session">
                                <Border Padding="10,8"
                                        Margin="2,8"
                                        FlexLayout.Basis="33%"
                                        Background="{Binding ListCardBackground}"
                                        Stroke="{Binding ListCardStroke}"
                                        StrokeThickness="{Binding ListCardStrokeThickness}"
                                        SemanticProperties.Hint="Mantener presionado para eliminar la sesión"
                                        behaviors:AnimatedTap.Command="{Binding NavigateToSessionCommand, Source={RelativeSource AncestorType={x:Type pageModels:GameDetailPageModel}}, x:DataType=pageModels:GameDetailPageModel}"
                                        behaviors:AnimatedTap.LongPressCommand="{Binding DeleteSessionCommand, Source={RelativeSource AncestorType={x:Type pageModels:GameDetailPageModel}}, x:DataType=pageModels:GameDetailPageModel}"
                                        behaviors:AnimatedTap.CommandParameter="{Binding .}"
                                        behaviors:AnimatedTap.PressedScale="0.97"
                                        behaviors:AnimatedTap.PressedOpacity="0.92">
                                    <!-- Cada texto ocupa un solo renglón: FlexLayout mide la tarjeta sin el ancho de la
                                         columna, así que un texto que se parte en dos renglones quedaba cortado abajo. -->
                                    <VerticalStackLayout Spacing="2" InputTransparent="True">
                                        <Label FontSize="14"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               Text="{Binding SessionDateLocal, StringFormat='{}{0:dd/MM/yy}'}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="TextColor" Value="{Binding ListCardIconColor}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label FontSize="13"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                               Text="{Binding SessionDateLocal, StringFormat='{}{0:HH:mm}'}" />

                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                            <Image HeightRequest="16" WidthRequest="16" VerticalOptions="Center">
                                                <Image.Source>
                                                    <FontImageSource Glyph="{x:Static f:FluentUI.star_24_regular}"
                                                                     FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                                     Color="{Binding ListCardIconColor}"
                                                                     Size="16" />
                                                </Image.Source>
                                            </Image>
                                            <Label Text="{Binding TotalWins}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"
                                                   TextColor="{Binding Game.CurrentGameColor, Source={RelativeSource AncestorType={x:Type pageModels:GameDetailPageModel}}, x:DataType=pageModels:GameDetailPageModel}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="TextColor" Value="{Binding ListCardIconColor}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Image HeightRequest="16" WidthRequest="16" VerticalOptions="Center" Margin="6,0,0,0">
                                                <Image.Source>
                                                    <FontImageSource Glyph="{x:Static f:FluentUI.people_24_regular}"
                                                                     FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                                     Color="{Binding ListCardIconColor}"
                                                                     Size="16" />
                                                </Image.Source>
                                            </Image>
                                            <Label Text="{Binding PlayerCount}"
                                                   FontSize="15"
                                                   VerticalOptions="Center"
                                                   TextColor="{Binding ListCardIconColor}" />
                                        </HorizontalStackLayout>

                                        <!-- Mejor jugador: solo si alguien ganó al menos una partida. -->
                                        <!-- Grid y no HorizontalStackLayout: el nombre recibe el ancho restante y se trunca con "…". -->
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" IsVisible="{Binding HasBestPlayer}">
                                            <Image HeightRequest="16" WidthRequest="16" VerticalOptions="Center">
                                                <Image.Source>
                                                    <FontImageSource Glyph="{x:Static f:FluentUI.crown_24_regular}"
                                                                     FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                                     Color="{Binding ListCardIconColor}"
                                                                     Size="18" />
                                                </Image.Source>
                                            </Image>
                                            <Label Grid.Column="1"
                                                   FontSize="14"
                                                   VerticalOptions="Center"
                                                   MaxLines="1"
                                                   LineBreakMode="TailTruncation"
                                                   FontAttributes="Bold"
                                                   Text="{Binding BestPlayer.Player, StringFormat='{0}'}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="TextColor" Value="{Binding ListCardIconColor}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>

                                        <Label Text="Activa"
                                               IsVisible="{Binding IsActive}"
                                               HorizontalOptions="End"
                                               TextColor="{Binding ListCardIconColor}"
                                               FontSize="12"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>

</ContentPage>
